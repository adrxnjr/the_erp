APP_NAME="Ever Grow Schools ERP"
APP_ENV=production
DEBUG=false
DISABLE_SQLALCHEMY_CEXT=1
API_V1_PREFIX="/api/v1"

# Production Secret Keys (Generate with: openssl rand -hex 32)
SECRET_KEY="generate-a-secure-random-32-character-secret-key-for-production"
JWT_SECRET_KEY="generate-a-secure-random-32-character-secret-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Leave empty or sqlite for SQLite, or provide PostgreSQL url)
# For SQLite (default):
# DATABASE_URL="sqlite:///./school_erp.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/school_erp_db"

# Allowed CORS Origins (comma-separated or * for public access)
CORS_ORIGINS="*"

UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
MAX_UPLOAD_SIZE_MB=15

LOG_LEVEL=INFO
