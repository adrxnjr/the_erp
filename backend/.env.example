# Application Configuration
APP_NAME="School ERP System"
APP_ENV=development
DEBUG=true
DISABLE_SQLALCHEMY_CEXT=1
API_V1_PREFIX="/api/v1"
SECRET_KEY="school-erp-insecure-development-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_erp_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/school_erp_db

# Security & CORS (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# File Storage
UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO
