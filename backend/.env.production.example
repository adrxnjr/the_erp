# Production Backend Configuration for Online FastAPI + PostgreSQL Server
APP_NAME="Ever Grow Schools ERP"
APP_ENV=production
DEBUG=false
DISABLE_SQLALCHEMY_CEXT=1
API_V1_PREFIX="/api/v1"

# Generate a strong 64-character secret key: openssl rand -hex 32
SECRET_KEY="replace-with-a-very-long-and-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Production PostgreSQL Database Connection
# Format: postgresql+psycopg://<user>:<password>@<db-host>:<db-port>/<database-name>
DATABASE_URL=postgresql+psycopg://postgres_user:strong_password@db.example.com:5432/school_erp_db

# CORS Configuration (Permit Web origins and Electron desktop client protocols)
CORS_ORIGINS="https://app.your-school.com,null,file://"

# File Storage
UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
MAX_UPLOAD_SIZE_MB=15

# Logging
LOG_LEVEL=INFO
